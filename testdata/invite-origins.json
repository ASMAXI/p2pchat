{
  "privateHosts": ["10.122.3.68", "192.168.1.5", "172.16.0.1", "127.0.0.1", "localhost"],
  "publicHosts": ["abc.trycloudflare.com", "example.com"],
  "shareableCases": [
    {
      "name": "drops-vpn-lan-when-public",
      "input": [
        "http://10.122.3.68:47821",
        "https://abc.trycloudflare.com",
        "http://192.168.1.10:47821"
      ],
      "expected": ["https://abc.trycloudflare.com"]
    },
    {
      "name": "keeps-lan-without-public",
      "input": [
        "http://192.168.1.10:47821",
        "http://10.0.0.2:47821",
        "http://127.0.0.1:47821"
      ],
      "expected": ["http://192.168.1.10:47821", "http://10.0.0.2:47821"]
    }
  ]
}
